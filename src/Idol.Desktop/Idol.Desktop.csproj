<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefineConstants Condition="'$(IdolUseCuda)' == 'false'">$(DefineConstants);IDOL_CPU</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Idol.Core\Idol.Core.csproj" />
    <ProjectReference Include="..\Idol.Inference\Idol.Inference.csproj" />
    <Content Include="..\..\unity\**\*" Link="Unity\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
