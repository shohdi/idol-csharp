<Window x:Class="Idol.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Idol.Desktop.Controls"
        Title="Idol Studio" Width="1280" Height="850" MinWidth="1000" MinHeight="700"
        Background="#0C111B" Foreground="#DCE5F1" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#8D9FB7"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#223044"/><Setter Property="Foreground" Value="#E3ECF7"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C1421"/><Setter Property="Foreground" Value="#DCE5F1"/>
            <Setter Property="BorderBrush" Value="#304057"/><Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0C1421"/><Setter Property="Foreground" Value="#DCE5F1"/>
            <Setter Property="BorderBrush" Value="#304057"/><Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#BCCBDD"/><Setter Property="Margin" Value="0,6,0,6"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Foreground" Value="#172031"/></Style>
    </Window.Resources>
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="38" Height="38" CornerRadius="10" Background="#70E4B3" Margin="0,0,12,0"><TextBlock Text="I" FontSize="25" FontWeight="Bold" Foreground="#112A27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel><TextBlock Text="IDOL STUDIO" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="One photo. A new perspective." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0">
                <Button Content="Open PLY" Click="OpenPly_Click" x:Name="OpenPlyButton" ToolTip="Open an existing standard 3D Gaussian PLY file"/>
                <Border Background="#142A25" CornerRadius="16" Padding="12,8" VerticalAlignment="Center"><TextBlock Text="C#  /  LOCAL INFERENCE" FontSize="10" Foreground="#83DEB8"/></Border>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#141D2B" BorderBrush="#233044" BorderThickness="1" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18" x:Name="SettingsPanel">
                        <TextBlock Text="SOURCE IMAGE" FontSize="10" FontWeight="SemiBold" Foreground="#91A3BC" Margin="0,0,0,12"/>
                        <Border Height="185" Background="#0C1421" CornerRadius="8" BorderBrush="#2D3B50" BorderThickness="1" ClipToBounds="True">
                            <Grid><TextBlock x:Name="PhotoPlaceholder" Text="A single object works best" Foreground="#647A96" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="PhotoPreview" Stretch="Uniform" Margin="8"/></Grid>
                        </Border>
                        <TextBlock x:Name="PhotoName" Text="No image selected" Foreground="#8195B0" FontSize="11" TextTrimming="CharacterEllipsis" Margin="1,8,0,12"/>
                        <Button x:Name="BrowseButton" Content="Browse photo…" Click="Browse_Click" Background="#70E4B3" Foreground="#112D29" Margin="0"/>
                        <TextBlock Text="Selecting a photo starts conversion." FontSize="11" Foreground="#8195B0" Margin="0,7,0,12"/>
                        <CheckBox x:Name="RealPhotoBox" Content="Real photograph" IsChecked="True" ToolTip="Use a looser crop for photographs. Clear for renders and generated images."/>
                        <Border Height="1" Background="#263246" Margin="0,13,0,17"/>
                        <TextBlock Text="GENERATION" FontSize="10" FontWeight="SemiBold" Foreground="#91A3BC" Margin="0,0,0,12"/>
                        <TextBlock Text="Detail / Gaussian count" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CountBox" SelectedIndex="1">
                            <ComboBoxItem Content="32,768 — quick preview" Tag="32768"/><ComboBoxItem Content="65,536 — balanced" Tag="65536"/>
                            <ComboBoxItem Content="262,144 — detailed" Tag="262144"/><ComboBoxItem Content="1,048,576 — maximum" Tag="1048576"/>
                        </ComboBox>
                        <Grid Margin="0,12,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Steps" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="StepsBox" Text="50"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Seed" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="SeedBox" Text="42"/></StackPanel>
                        </Grid>
                        <Button x:Name="RegenerateButton" Content="Generate again" Click="Regenerate_Click" Margin="0" IsEnabled="False"/>
                        <Expander Header="Model setup" Foreground="#BBCBDD" Margin="0,20,0,0" FontSize="12">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Hugging Face read token" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><PasswordBox x:Name="TokenBox" ToolTip="Held in memory only; HF_TOKEN is used when this is empty."/>
                                <TextBlock Text="Kept in memory only. HF_TOKEN also works." FontSize="10" Foreground="#8195B0" TextWrapping="Wrap" Margin="0,6,0,8"/>
                                <TextBlock Text="Accept encoder access terms:" FontSize="11" Foreground="{StaticResource Muted}"/>
                                <TextBlock Margin="0,6,0,0" FontSize="11"><Hyperlink NavigateUri="https://huggingface.co/facebook/dinov3-vith16plus-pretrain-lvd1689m" RequestNavigate="ModelLink_RequestNavigate" Foreground="#70E4B3">DINOv3 ViT-H+</Hyperlink><Run Text="   "/><Hyperlink NavigateUri="https://huggingface.co/black-forest-labs/FLUX.2-dev" RequestNavigate="ModelLink_RequestNavigate" Foreground="#70E4B3">FLUX.2-dev</Hyperlink></TextBlock>
                                <TextBlock Text="Model cache folder" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,6"/><TextBox x:Name="ModelDirectoryBox" TextWrapping="Wrap" MinHeight="50"/>
                                <CheckBox x:Name="CpuBox" Content="Use CPU (very slow)"/>
                                <TextBlock Text="Weights download on first use. Large downloads and gated access are required." TextWrapping="Wrap" FontSize="10" Foreground="#8195B0" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" BorderBrush="#253248" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Background="#101A29">
                <Grid>
                    <controls:GaussianViewport x:Name="Viewport"/>
                    <Border Background="#DB121C2B" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17" Padding="10,7"><TextBlock x:Name="ObjectInfo" Text="3D VIEWPORT" FontSize="10" Foreground="#A4B6CC"/></Border>
                    <Button Content="Reset view" Click="ResetView_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" Padding="11,7" Background="#C9273549"/>
                    <Border Background="#D50D1623" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="12,8"><TextBlock Text="Drag to orbit   ·   Right-drag to pan   ·   Scroll to zoom   ·   F to frame" FontSize="11" Foreground="#9DB1CB"/></Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0">
                <Grid><TextBlock x:Name="StageText" Text="Ready to create" Foreground="#D5E1F0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" HorizontalAlignment="Right" Padding="10,3" Margin="0"/></Grid>
                <ProgressBar x:Name="Progress" Height="3" Minimum="0" Maximum="100" Value="0" Background="#1E2B3E" Foreground="#70E4B3" BorderThickness="0" Margin="0,9,0,6"/>
                <TextBlock x:Name="DetailText" Text="Conversion runs locally. Photos stay on your computer." Foreground="#8195B0" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" x:Name="ExportPanel" IsEnabled="False">
                <Button Content="Save PLY" Click="SavePly_Click"/><Button Content="OBJ proxy" Click="SaveObj_Click" ToolTip="Coarse ellipsoid geometry; loses the splat appearance"/>
                <Button Content="Export to Unity" Click="ExportUnity_Click" Background="#70E4B3" Foreground="#112D29" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
